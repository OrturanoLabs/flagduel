{
  "name": "flag-duel",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"tsx watch apps/server/src/index.ts\" \"vite --config apps/web/vite.config.ts\"",
    "preprocess": "tsx scripts/preprocess.ts",
    "test": "vitest run tests",
    "typecheck": "tsc --noEmit",
    "build": "npm run preprocess && npm run licenses && npm run typecheck && vite build --config apps/web/vite.config.ts && esbuild apps/server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js && esbuild scripts/statistics-info.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/statistics-info.js",
    "start": "NODE_ENV=production node dist/server.js",
    "test:e2e": "playwright test",
    "licenses": "tsx scripts/licenses.ts",
    "stats:url": "node dist/statistics-info.js"
  },
  "dependencies": {
    "canvaskit-wasm": "^0.42.0",
    "color-string": "^2.1.4",
    "express": "^5.1.0",
    "jsdom": "^26.1.0",
    "paper": "^0.12.18",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/color-string": "^1.5.5",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^21.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.0.0",
    "country-flag-icons": "^1.6.20",
    "esbuild": "^0.25.0",
    "flag-icons": "^7.5.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.1.0",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "description": "Duello multiplayer a turni con bandiere e indizi geometrici SVG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrturanoLabs/flagduel.git"
  }
}
